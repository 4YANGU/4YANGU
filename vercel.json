{
  "rewrites": [
    {
      "source": "/api/store-pwa/manifest",
      "destination": "/api/stores?pwa=manifest"
    },
    {
      "source": "/api/store-pwa/icon",
      "destination": "/api/stores?pwa=icon"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/founder",
      "destination": "/index.html"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    },
    {
      "source": "/manage/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/s/(.*)",
      "destination": "/index.html"
    }
  ]
}
