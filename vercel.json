{
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": ":slug.stoyangu.com" }], "destination": "/api/seo?type=storefront-html" },
    { "source": "/robots.txt", "destination": "/api/seo?type=robots" },
    { "source": "/sitemap.xml", "destination": "/api/seo?type=sitemap" },
    { "source": "/catalog.json", "destination": "/api/seo?type=catalog" },
    { "source": "/llms-full.txt", "destination": "/api/seo?type=llms-full" },
    { "source": "/s/:slug", "destination": "/api/seo?type=storefront-html&slug=:slug" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/founder", "destination": "/index.html" },
    { "source": "/owner", "destination": "/index.html" },
    { "source": "/manage/:storeId", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/stores", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron?job=daily", "schedule": "0 16 * * *" },
    { "path": "/api/cron?job=send", "schedule": "30 16 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ]
}
