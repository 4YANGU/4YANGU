{
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "PASTE_YOUR_SUPABASE_PROJECT_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "PASTE_YOUR_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY": "PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY",
    "VITE_SUPABASE_URL": "PASTE_YOUR_SUPABASE_PROJECT_URL",
    "VITE_SUPABASE_ANON_KEY": "PASTE_YOUR_SUPABASE_ANON_KEY"
  },
  "rewrites": [
    {
      "source": "/api/track",
      "destination": "/api/engage?fn=track"
    },
    {
      "source": "/api/applications",
      "destination": "/api/engage?fn=applications"
    },
    {
      "source": "/api/cron",
      "destination": "/api/batch?fn=cron"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/batch?fn=notifications"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": ":slug.stoyangu.com"
        }
      ],
      "destination": "/api/seo?type=storefront-html"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?type=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/catalog.json",
      "destination": "/api/seo?type=catalog"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/seo?type=llms-full"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/seo?type=storefront-html&slug=:slug"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/founder",
      "destination": "/index.html"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    },
    {
      "source": "/manage/:storeId",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/stores",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?job=daily",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron?job=send",
      "schedule": "30 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ]
}